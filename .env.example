# Sarvam Doc AI configuration
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_LANGUAGE=en-IN
SARVAM_TIMEOUT_SECONDS=45
SARVAM_POLL_INTERVAL_SECONDS=2
SARVAM_MAX_WAIT_SECONDS=90
# Set true for local testing/demo without live API key
SARVAM_USE_MOCK=false

# SMTP notification configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=bot@example.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_USE_TLS=true
NOTIFY_EMAIL=ops@example.com

# Output directory for reports
OUTPUT_DIR=output
